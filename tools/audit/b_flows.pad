expect menu
shot
# Lua mods: switch the first script with the context button
tap down 5
tap down 2
tap a
expect mods
tap x
shot
tap b
expect menu
# Controls: bind the right stick click to Shoot as well
tap down
tap a
expect controls
tap down 3
tap down 4
tap a
wait 300
tap rs
wait 500
shot
tap b
expect menu
# News, About (its Controls tab)
tap down
tap a
expect news
tap b
tap down
tap a
expect about
tap rb
shot
tap b
expect menu
# T.E.
tap up 5
tap up
tap up 3
tap a
wait 9000
