# roadmap 3.3: dist/NBAJamRecomp/mods/codes_mht.lua forces the Maximum Hangtime 1.3 codes;
# codes_probe_mht.lua lists the power-up variables 4 s and 20 s into the game.
# - every number code is 0xF, what it is when entered (codes_mht.expect);
# - per-player codes for cabinet player 1 are bit 1 (2) and for player 2 bit 2 (4), as when
#   entered on this two-player cabinet;
# - with tournament mode on, a code it clears (baby) is greyed; huge head is kept;
# - with every switch off the RAM hash at 4000 and 4500 equals an unmodded run's (empty folder).
script dist/NBAJamRecomp/mods/codes_mht.lua
extra codes_probe_mht.lua
game nbamht
frames 5000
env PLAY=1
env HASH=4000,4500
run baby=0
run baby=1 no_music=1 goaltend=1 max_block=1 max_steal=1 max_power=1 max_speed=1 hyper_speed=1 stealth_turbo=1 infinite_turbo=1 no_push=1 fast_pass=1
run big_head=1 shot_percent=1 no_tag=1 no_drift=2 no_assistance=1 aba_ball=1 outdoor_court=1
run tournament=1 baby=1 huge_head=1
baby=0: nolog forcing
baby=0: once late 240: none
baby=0: once hash 4000 82819af4
baby=0: once hash 4500 d4d5819a
no_music=1: once forcing fast_pass (pup_fastpass)
no_music=1: once late 240: baby=F nomusic=F goaltend=F maxblock=F maxsteal=F maxpower=F maxspeed=F hypspeed=F trbstealth=F trbinfinite=F nopush=F fastpass=F
no_music=1: once late 1200: baby=F nomusic=F goaltend=F maxblock=F maxsteal=F maxpower=F maxspeed=F hypspeed=F trbstealth=F trbinfinite=F nopush=F fastpass=F
big_head=1: once late 240: bighead=2 showshotper=2 notag=2 nodrift=4 noassistance=1 aba=1 court=1
big_head=1: once late 1200: bighead=2 showshotper=2 notag=2 nodrift=4 noassistance=1 aba=1 court=1
tournament=1: nolog forcing baby
tournament=1: once late 240: tournament=F hugehead=2
