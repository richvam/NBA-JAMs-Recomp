# Phase 1 review, 1.3: list 3 (a list value is a Lua float: 3.0), toggle on (a boolean), range 2.5, players 1 and 3 (mask 5);
# "loser" names "flag" in conflicts, so with flag on it reads its default 10, not the 20 set.
game nbajamte nbajamse nbamht nbajam nbahangt
frames 10
opt list=3
opt flag=1
opt len=2.5
opt who=5
opt loser=20
opt free=20
once list=3.0 flag=true len=2.5 who=5 loser=10.0 free=20.0
