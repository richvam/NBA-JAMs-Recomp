# events.lua with PLAY=1 (modtest presses start, then shoot to pick): the game waits at
# power-on (GAMSTATE 0) until a button, then plays a whole game. Each event once, in order.
# NBA Jam and NBA Hangtime have no symbol file yet: the library says so and calls nothing.
game nbajamte nbajamse nbamht nbajam nbahangt
frames 45000
env PLAY=1
nbajamte: expect 300 GAMSTATE == 0
nbajamse: expect 300 GAMSTATE == 0
nbamht: expect 300 GAMSTATE == 0
nbajamte: expect 5000 GAMSTATE == 3
nbajamse: expect 5000 GAMSTATE == 3
nbamht: expect 5000 GAMSTATE == 3
nbajamte: once : matchup
nbajamse: once : matchup
nbamht: once : matchup
nbajamte: once : game start
nbajamse: once : game start
nbamht: once : game start
nbajamte: once : quarter 1
nbajamse: once : quarter 1
nbamht: once : quarter 1
nbajamte: once : quarter 2
nbajamse: once : quarter 2
nbamht: once : quarter 2
nbajamte: once : quarter 3
nbajamse: once : quarter 3
nbamht: once : quarter 3
nbajamte: once : quarter 4
nbajamse: once : quarter 4
nbamht: once : quarter 4
nbajamte: once : game end
nbajamse: once : game end
nbamht: once : game end
nbajam: once no game events for nbajam
nbahangt: once no game events for nbahangt
nbajam: nolog EVENT
nbahangt: nolog EVENT
