# roadmap Phase 6: dist/NBAJamRecomp/mods/cpu_difficulty.lua; cpu_probe.lua logs each
# player's plyr_d_skill/plyr_ptsdown 1200 and 2400 frames into the game (player 1 is a person,
# player 2 its computer teammate, players 3 and 4 the computer opponents).
# - with the game's settings the opponents sit at -15 (T.E.) or -6 (SE) and the teammate at 0;
# - "CPU skill" holds every computer player (2, 3, 4) at the chosen value, never player 1;
# - "Catch-up help" off holds plyr_ptsdown at 0 for all four;
# - each changed game is kept out of the players' records ("Protect records").
# The final score is logged but not a measure of the skill: these single games do not follow it.
script dist/NBAJamRecomp/mods/cpu_difficulty.lua
extra cpu_probe.lua
game nbajamte nbajamse
frames 36001
env PLAY=1
run skill=99 catch_up=1
run skill=-15
run skill=15
run skill=99 catch_up=0
catch_up=1: nolog cpu skill
nbajamte: catch_up=1: once cpu 1200: p1 0/2 p2 0/2 p3 -15/-2 p4 -15/-2
nbajamse: catch_up=1: log cpu 1200: p1 0/0 p2 0/0 p3 -6/0 p4 -6/0
skill=-15: once cpu skill -15
skill=-15: log p2 -15/
skill=-15: log p3 -15/
skill=-15: log p4 -15/
skill=-15: nolog p1 -15
skill=15: once cpu skill 15
skill=15: once cpu 1200: p1 0/
skill=15: log p2 15/
skill=15: log p3 15/
skill=15: log p4 15/
catch_up=0: once catch-up off
catch_up=0: once cpu 2400: p1
catch_up=0: nolog /2
catch_up=0: log protect records: this game is not saved
